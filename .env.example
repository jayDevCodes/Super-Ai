# Browser planner
SUPER_AI_BROWSER_MODEL=qwen3.5:4b-q4_K_M
SUPER_AI_OLLAMA_URL=http://127.0.0.1:11434
# Keep installed models warm for faster repeated tasks. Use 0 to unload immediately.
SUPER_AI_OLLAMA_KEEP_ALIVE=5m
# Keep unset unless you intentionally use a remote planner.
# SUPER_AI_ALLOW_REMOTE_PLANNER=1

# Browser CLI
SUPER_AI_PLAYWRIGHT_CLI=playwright-cli
