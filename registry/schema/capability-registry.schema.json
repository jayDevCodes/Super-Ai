{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://super-ai.local/schema/capability-registry.json",
  "type": "object",
  "required": [
    "capabilities"
  ],
  "properties": {
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "manifest",
          "spec"
        ],
        "properties": {
          "manifest": {
            "type": "object",
            "required": [
              "capability_id",
              "version",
              "artifact"
            ],
            "properties": {
              "capability_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "artifact": {
                "type": "object"
              },
              "runtime": {
                "type": "object",
                "required": [
                  "image",
                  "command"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "minLength": 1
                  },
                  "command": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "timeout_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3600
                  },
                  "expected_image_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-fA-F]{64}$"
                  },
                  "working_directory": {
                    "type": "string",
                    "pattern": "^/"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "spec": {
            "type": "object",
            "required": [
              "capability_id",
              "version",
              "description",
              "resource"
            ]
          }
        }
      }
    }
  }
}
